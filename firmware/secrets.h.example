// secrets.h.example — copy this file to secrets.h and fill in your values.
// secrets.h is git-ignored; NEVER commit the real one.

#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASS       "YOUR_WIFI_PASSWORD"

// Must match a key configured on the backend:
//   firebase functions:config:set telemetry.device_keys='{"esp32-soil-001":"YOUR_KEY"}'
#define DEVICE_ID       "esp32-soil-001"
#define DEVICE_KEY      "YOUR_DEVICE_KEY"
#define ENDPOINT_URL    "https://asia-southeast1-soilpollution1-3c0d4.cloudfunctions.net/apiTelemetry"

// Optional static IP (set USE_STATIC_IP in the .ino to enable)
#define STATIC_IP       192,168,197,53
#define STATIC_GW       192,168,197,76
#define STATIC_SN       255,255,255,0

// Optional Blynk (enable with #define USE_BLYNK in the .ino)
#define BLYNK_TEMPLATE_ID   "YOUR_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_TOKEN"
